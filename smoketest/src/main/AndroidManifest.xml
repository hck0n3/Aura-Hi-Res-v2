<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only APK (never published). It looks at the app from outside: package visibility to find it and bind its
     MediaSession, the audio MediaStore to check the pushed tone, the network state to prove it went offline. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application />
</manifest>
