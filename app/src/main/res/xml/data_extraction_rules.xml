<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Don't export the login session (InnerTube cookie in the "settings" datastore). -->
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <!-- Never export the license state (subscription key, device id, demo timestamps). -->
        <exclude
            domain="sharedpref"
            path="jr_license.xml" />
        <!-- HALLAZGO-016 (FASE 22): derived caches and diagnostic logs carry no user value but can
             leak listening history; both are rebuilt on demand in-app. -->
        <exclude
            domain="sharedpref"
            path="song_graph.xml" />
        <exclude
            domain="sharedpref"
            path="artist_genres.xml" />
        <exclude
            domain="file"
            path="./logs" />
        <!-- HALLAZGO-016 resto (aprobado por el dueño 2026-08-25): la cola persistente, el automix y
             el estado del reproductor llevan metadatos de escucha; no viajan al backup en la nube. La
             copia dentro de la app los sigue llevando (lee los archivos directamente). -->
        <exclude
            domain="file"
            path="persistent_queue.data" />
        <exclude
            domain="file"
            path="persistent_automix.data" />
        <exclude
            domain="file"
            path="persistent_player_state.data" />
        <!-- song.db stays INCLUDED on purpose (the library must survive a phone change); the restored
             data is treated as untrusted instead — see App.classifyInstallOrigin. The sharedpref
             "aura_install_marker" must also stay INCLUDED: it is what tells a restored first launch
             apart from a genuinely fresh one. -->

        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <!-- Never transfer the license state (subscription key, device id, demo timestamps). -->
        <exclude
            domain="sharedpref"
            path="jr_license.xml" />
        <!-- Same HALLAZGO-016 exclusions as cloud-backup: derived caches and logs stay local. -->
        <exclude
            domain="sharedpref"
            path="song_graph.xml" />
        <exclude
            domain="sharedpref"
            path="artist_genres.xml" />
        <exclude
            domain="file"
            path="./logs" />
        <!-- Mismas exclusiones de HALLAZGO-016 resto que en cloud-backup. -->
        <exclude
            domain="file"
            path="persistent_queue.data" />
        <exclude
            domain="file"
            path="persistent_automix.data" />
        <exclude
            domain="file"
            path="persistent_player_state.data" />
        <!-- Same as cloud-backup: song.db travels, the sharedpref "aura_install_marker" travels, and
             the restored account-scoped artist markers are cleared on arrival. -->

        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
    </device-transfer>
</data-extraction-rules>