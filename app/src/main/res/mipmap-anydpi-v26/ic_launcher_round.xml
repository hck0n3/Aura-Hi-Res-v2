<?xml version="1.0" encoding="utf-8"?>
<!-- Row 620: Aura launcher icon in the new glass style, LIGHT mode (the default). The -night variant is the dark one; the themed (Android 13+) icon uses the monochrome layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_light" />
    <foreground android:drawable="@drawable/ic_launcher_mark_light" />
    <monochrome android:drawable="@drawable/ic_launcher_mark_mono" />
</adaptive-icon>
